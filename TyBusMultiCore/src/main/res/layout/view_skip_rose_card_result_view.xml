<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_270"
    android:layout_height="@dimen/dp_548"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_491"
        android:background="@mipmap/pic_cpt_resultpage_nobody"
        app:layout_constraintTop_toTopOf="parent" />

    <!--  头像名字  -->
    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_header"
        android:layout_width="@dimen/dp_62"
        android:layout_height="@dimen/dp_62"
        android:layout_marginTop="@dimen/dp_6"
        android:background="@mipmap/ic_head_default"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_crown"
        app:layout_constraintLeft_toLeftOf="@+id/iv_header_crown"
        app:layout_constraintRight_toRightOf="@+id/iv_header_crown"
        app:layout_constraintTop_toTopOf="@+id/iv_header_crown" />

    <ImageView
        android:id="@+id/iv_header_bg"
        android:layout_width="@dimen/dp_108"
        android:layout_height="@dimen/dp_108"
        android:background="@mipmap/icon_header_bg_vip"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header"
        app:layout_constraintEnd_toEndOf="@+id/iv_header"
        app:layout_constraintStart_toStartOf="@+id/iv_header"
        app:layout_constraintTop_toTopOf="@+id/iv_header" />

    <ImageView
        android:id="@+id/iv_header_crown"
        android:layout_width="@dimen/dp_128"
        android:layout_height="@dimen/dp_80"
        android:background="@mipmap/ic_avatar_no1"
        app:layout_constraintBottom_toTopOf="@+id/tv_name"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:ellipsize="end"
        android:maxEms="6"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_32"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_header_crown" />

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_80"
        android:text="999"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toLeftOf="@+id/tv_unit" />

    <TextView
        android:id="@+id/tv_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_7"
        android:text="个"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_32"
        app:layout_constraintBottom_toBottomOf="@+id/tv_count"
        app:layout_constraintLeft_toRightOf="@+id/tv_count"
        app:layout_constraintRight_toRightOf="@+id/iv_bg" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_name,iv_header,iv_header_bg,iv_header_crown,tv_count,tv_unit" />

    <TextView
        android:id="@+id/tv_nobody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_92"
        android:text="@string/idle_state"
        android:textColor="@color/white_40"
        android:textSize="@dimen/sp_32"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg" />

    <ImageView
        android:id="@+id/iv_top1_cup"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_36"
        android:background="@mipmap/ic_exe_cpt_5jp_top1"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_top1_today" />

    <TextView
        android:id="@+id/tv_top1_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="@string/the_best_today"
        android:textColor="#FDD401"
        android:textSize="@dimen/sp_20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_top1_cup"
        app:layout_constraintLeft_toRightOf="@+id/iv_top1_cup"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_top1_cup" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_top1_cup,tv_top1_today" />

    <Button
        android:id="@+id/btn_report"
        android:layout_width="@dimen/dp_184"
        android:layout_height="@dimen/dp_64"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@drawable/pk_bg_btn_gradient_blue"
        android:text="@string/sport_report"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>