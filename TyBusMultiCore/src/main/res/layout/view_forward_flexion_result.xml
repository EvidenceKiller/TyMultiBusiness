<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_new_all">

    <ImageView
        android:id="@+id/iv_complete"
        android:layout_width="@dimen/dp_1088"
        android:layout_height="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_155"
        android:background="@mipmap/pic_test_zwtqq_complete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_score_1"
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_400"
        android:layout_marginTop="@dimen/dp_358"
        android:background="@mipmap/bg_test_zwtqq_complete"
        app:layout_constraintEnd_toStartOf="@+id/cl_score_3"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.ty.tybusbase.view.CircleImageView
            android:id="@+id/civ_header_1"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/civ_header_1" />

        <TextView
            android:id="@+id/tv_score_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_72"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_unit_1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name_1"
            tools:text="18.6" />

        <TextView
            android:id="@+id/tv_unit_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_3"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold"
            android:text="cm"
            app:layout_constraintBottom_toBottomOf="@+id/tv_score_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_score_1"
            tools:text="cm" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_score_3"
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_400"
        android:layout_marginStart="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_358"
        android:background="@mipmap/bg_test_zwtqq_complete"
        app:layout_constraintEnd_toStartOf="@+id/cl_score_2"
        app:layout_constraintStart_toEndOf="@+id/cl_score_1"
        app:layout_constraintTop_toTopOf="parent">

        <com.ty.tybusbase.view.CircleImageView
            android:id="@+id/civ_header_3"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_name_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/civ_header_3" />

        <TextView
            android:id="@+id/tv_score_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_72"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_unit_3"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name_3"
            tools:text="18.6" />

        <TextView
            android:id="@+id/tv_unit_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_3"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold"
            android:text="cm"
            app:layout_constraintBottom_toBottomOf="@+id/tv_score_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_score_3"
            tools:text="cm" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_score_2"
        android:layout_width="@dimen/dp_320"
        android:layout_height="@dimen/dp_400"
        android:layout_marginStart="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_358"
        android:background="@mipmap/bg_test_zwtqq_complete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cl_score_3"
        app:layout_constraintTop_toTopOf="parent">

        <com.ty.tybusbase.view.CircleImageView
            android:id="@+id/civ_header_2"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_56"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_name_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/civ_header_2" />

        <TextView
            android:id="@+id/tv_score_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_72"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_unit_2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name_2"
            tools:text="18.6" />

        <TextView
            android:id="@+id/tv_unit_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_3"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold"
            android:text="cm"
            app:layout_constraintBottom_toBottomOf="@+id/tv_score_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_score_2"
            tools:text="cm" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_retest"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_120"
        android:background="@drawable/bg_btn_white_r50"
        android:gravity="center"
        android:text="@string/retest"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_next"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_60"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/tv_finish"
        app:layout_constraintStart_toEndOf="@+id/tv_retest"
        app:layout_constraintTop_toTopOf="@+id/tv_retest" />


    <TextView
        android:id="@+id/tv_finish"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_60"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/end_test"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_next"
        app:layout_constraintTop_toTopOf="@+id/tv_retest" />


</androidx.constraintlayout.widget.ConstraintLayout>