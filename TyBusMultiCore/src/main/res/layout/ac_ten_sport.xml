<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_exe_cpt_5jumprope"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.adl.lib.AdlCameraPreviewView
        android:id="@+id/camera_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="-1px"
        android:layout_width="1px"
        android:layout_height="1px"/>

    <FrameLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <com.adl.base.overlay.SportOverlayMultiRegion
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <TextView
        android:id="@+id/tv_enter"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/start_competition"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_45"
        android:layout_marginLeft="@dimen/dp_40"
        android:textSize="@dimen/dp_56"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <LinearLayout
        android:id="@+id/ll_top1_icon"
        app:layout_constraintRight_toLeftOf="@+id/ll_top1_info"
        app:layout_constraintTop_toTopOf="@+id/ll_top1_info"
        app:layout_constraintBottom_toBottomOf="@+id/ll_top1_info"
        android:layout_marginRight="@dimen/dp_38"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="@mipmap/ic_exe_cpt_5jp_top1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_20"
            android:textColor="#FDD401"
            android:text="@string/the_best_today"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_top1_info"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:background="@drawable/pk_rank_top_1_bg_5jum"
        android:paddingHorizontal="@dimen/dp_32"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_80">
        <com.ty.tybusbase.view.CircleImageView
            android:id="@+id/civ_header"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/ic_exe_cpt_5jp_nobody"/>
        <TextView
            android:id="@+id/tv_name"
            android:textSize="@dimen/sp_24"
            android:textColor="@color/white"
            android:layout_marginLeft="@dimen/dp_18"
            android:text="@string/no_one_on_list"
            android:maxEms="5"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_count"
            android:textSize="@dimen/dp_48"
            android:layout_marginLeft="@dimen/dp_20"
            android:text="260"
            android:visibility="gone"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="@dimen/sp_24"
            android:visibility="gone"
            android:textColor="@color/white_80"
            android:text="@string/ge"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_today_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ll_top1_info,ll_top1_icon"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_skip_sport_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ty.bus.multi.core.view.tensport.TenSportSportView
            android:id="@+id/sport_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_camera_tips"
        android:textSize="@dimen/sp_28"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:visibility="gone"
        android:text="@string/ipc_camera_fail_tip"
        android:layout_marginTop="@dimen/dp_60"/>

    <LinearLayout
        android:id="@+id/ll_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout"
        android:layout_marginBottom="@dimen/dp_88"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/bnt_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂停"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="change"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一帧"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="layout,ll_btn"/>

</androidx.constraintlayout.widget.ConstraintLayout>