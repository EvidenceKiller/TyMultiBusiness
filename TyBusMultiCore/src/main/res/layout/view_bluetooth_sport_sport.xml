<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="#999999">

    <TextView
        android:id="@+id/tv_test_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_45"
        android:text="@string/end_test"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.bluetooth.BluetoothSportCardView
        android:id="@+id/blue_sport_card1"
        android:layout_width="@dimen/dp_524"
        android:layout_height="@dimen/dp_660"
        app:layout_constraintEnd_toStartOf="@+id/blue_sport_card2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/blue_sport_card2"
        app:pk_index="1" />

    <com.ty.bus.multi.core.view.bluetooth.BluetoothSportCardView
        android:id="@+id/blue_sport_card2"
        android:layout_width="@dimen/dp_524"
        android:layout_height="@dimen/dp_660"
        android:layout_marginHorizontal="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_200"
        app:layout_constraintEnd_toStartOf="@+id/blue_sport_card3"
        app:layout_constraintStart_toEndOf="@+id/blue_sport_card1"
        app:layout_constraintTop_toTopOf="parent"
        app:pk_index="2" />

    <com.ty.bus.multi.core.view.bluetooth.BluetoothSportCardView
        android:id="@+id/blue_sport_card3"
        android:layout_width="@dimen/dp_524"
        android:layout_height="@dimen/dp_660"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/blue_sport_card2"
        app:layout_constraintTop_toTopOf="@+id/blue_sport_card2"
        app:pk_index="3" />

    <TextView
        android:id="@+id/tv_start_test"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_c4_r73_shape"
        android:gravity="center"
        android:text="@string/start_test"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_end_test"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_ff4b3d_r73_shape"
        android:gravity="center"
        android:text="@string/start_test"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <TextView
        android:id="@+id/tv_finish"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/finish"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/blue_sport_card1" />

    <LinearLayout
        android:id="@+id/ll_speech"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="@mipmap/video_ic_play_default" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/result_speech"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_retest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_border_r50_white_shape"
        android:paddingHorizontal="@dimen/dp_88"
        android:paddingVertical="@dimen/dp_19"
        android:text="@string/retest_once"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_next" />

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_40"
        android:background="@drawable/bg_border_r50_white_shape"
        android:paddingHorizontal="@dimen/dp_88"
        android:paddingVertical="@dimen/dp_19"
        android:text="@string/next_group"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/blue_sport_card3" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_test_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_next,tv_retest,ll_speech,tv_finish" />
</androidx.constraintlayout.widget.ConstraintLayout>