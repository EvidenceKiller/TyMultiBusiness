<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.adl.sport.standard.markerrecognizer.ui.MarkerRecognizerOverlay
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/bg_exe_cpt_5jumprope" />

    <TextView
        android:id="@+id/tv_enter"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_80"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/start_competition"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_45"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_56"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.foursport.FourSportSportView
        android:id="@+id/sport_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_246"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.foursport.FourSportResultView
        android:id="@+id/result_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 倒计时提示文案（属于整个运动，不随区域切换） -->
    <com.ty.tybusbase.view.MyLinerGradientTextVIewType1
        android:id="@+id/tv_count_down_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:textSize="@dimen/dp_64"
        android:visibility="gone"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_start_now"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 开始按钮（属于整个运动，不随区域切换） -->
    <TextView
        android:id="@+id/tv_start_now"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/start_now"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tv_count_down_notice"
        app:layout_constraintLeft_toRightOf="@+id/tv_count_down_notice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_count_down_notice" />

    <!-- 倒计时时间栏（属于整个运动，不随区域切换） -->
    <LinearLayout
        android:id="@+id/ll_time"
        android:layout_width="@dimen/dp_358"
        android:layout_height="@dimen/dp_96"
        android:background="@mipmap/pic_time_default_more"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_time_icon"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/icon_time_countdown" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_56" />
    </LinearLayout>

    <!-- 全屏大数字倒计时（属于整个运动，覆盖在区域面板之上） -->
    <TextView
        android:id="@+id/tv_count_down_go"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_50"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textFontWeight="600"
        android:textSize="@dimen/dp_400"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_camera_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/ipc_camera_fail_tip"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_88"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/bnt_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂停"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="change"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/bnt_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一帧"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
