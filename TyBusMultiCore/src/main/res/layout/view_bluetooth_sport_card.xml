<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/blue_sports_bg_datacard_nobody">

    <TextView
        android:id="@+id/tv_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_30"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_blue_icon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginStart="@dimen/dp_16"
        android:background="@mipmap/ic_blueteeth_disconnect"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tv_index"
        app:layout_constraintStart_toEndOf="@+id/tv_index"
        app:layout_constraintTop_toTopOf="@+id/tv_index" />

    <TextView
        android:id="@+id/tv_blue_connect_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:text="@string/disconnected"
        android:textColor="#F62227"
        android:textSize="@dimen/sp_32"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/iv_blue_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_blue_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_blue_icon"
        tools:text="断开" />


    <TextView
        android:id="@+id/tv_idle_state"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_42"
        android:layout_marginEnd="@dimen/dp_32"
        android:background="@drawable/bg_white_20_r12_shape"
        android:gravity="center"
        android:text="@string/idle_state"
        android:textColor="@color/white_40"
        android:textSize="@dimen/sp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <TextView
        android:id="@+id/tv_disconnect_tip"
        android:layout_width="@dimen/dp_207"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_32"
        android:gravity="center_horizontal"
        android:lineHeight="@dimen/dp_58"
        android:text="@string/bluetooth_disconnect_tips"
        android:textColor="@color/white_60"
        android:textSize="@dimen/sp_40"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gl_1" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4" />

    <LinearLayout
        android:id="@+id/ll_face_card_identify"
        android:layout_width="@dimen/dp_460"
        android:layout_height="@dimen/dp_274"
        android:background="@drawable/bg_white_20_r15_shape"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gl_2">

        <ImageView
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:background="@mipmap/sports_ic_facescan" />

        <TextView
            android:id="@+id/tv_identify_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_28"
            tools:text="刷卡/人脸识别" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_click_add"
        android:layout_width="@dimen/dp_460"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@drawable/bg_white_20_r15_shape"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_face_card_identify">

        <ImageView
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:background="@mipmap/sports_ic_adduser" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/click_add"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>

    <!--  已准备  -->
    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_32"
        android:background="@mipmap/ic_delete"
        app:layout_constraintBottom_toBottomOf="@+id/tv_index"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_index" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_92"
        android:ellipsize="end"
        android:maxEms="5"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="@+id/civ_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/civ_header"
        tools:text="张文方式电风扇" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/civ_header"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginEnd="@dimen/dp_20"
        android:background="@mipmap/ic_head_default"
        app:layout_constraintBottom_toBottomOf="@+id/tv_index"
        app:layout_constraintEnd_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_index" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_account_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_name,civ_header" />

    <ImageView
        android:id="@+id/iv_prepared_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_forward_flexion_sport_card_prepared"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.27"
        app:layout_constraintTop_toTopOf="@+id/gl_1" />

    <TextView
        android:id="@+id/tv_prepared_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prepared"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintBottom_toBottomOf="@+id/iv_prepared_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_prepared_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_prepared_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_prepared_bg" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_prepared"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_prepared_state,iv_prepared_bg,iv_delete" />

    <!--  成绩  -->
    <FrameLayout
        android:id="@+id/rl_result_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/dp_21"
        app:layout_constraintTop_toBottomOf="@+id/civ_header" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />

    <ImageView
        android:id="@+id/iv_sport_no_user"
        android:layout_width="@dimen/dp_190"
        android:layout_height="@dimen/dp_160"
        android:background="@mipmap/ic_sport_nouser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gl_3" />

    <TextView
        android:id="@+id/tv_idle_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/idle_state"
        android:textColor="@color/white_30"
        android:textSize="@dimen/sp_48"
        app:layout_constraintEnd_toEndOf="@+id/iv_sport_no_user"
        app:layout_constraintStart_toStartOf="@+id/iv_sport_no_user"
        app:layout_constraintTop_toBottomOf="@+id/iv_sport_no_user"
        app:layout_goneMarginTop="@dimen/dp_20" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_card_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_sport_no_user,tv_idle_tip" />

</androidx.constraintlayout.widget.ConstraintLayout>