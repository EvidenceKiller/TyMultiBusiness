<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--第一位置-->
    <com.ty.bus.multi.core.view.common.MultiSportIdentityCardView
        android:id="@+id/identity_card1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_128"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/dp_160" />

    <!--    中间位置  -->
    <com.ty.bus.multi.core.view.common.MultiSportIdentityCardView
        android:id="@+id/identity_card3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/identity_card1" />

    <!--  第3号位置  -->
    <com.ty.bus.multi.core.view.common.MultiSportIdentityCardView
        android:id="@+id/identity_card2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_160"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/identity_card1" />

</androidx.constraintlayout.widget.ConstraintLayout>