<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ty.bus.multi.core.view.doublesport.SurfaceOverlay
        android:id="@+id/surface_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.adl.sport.standard.ui.SportOverlayRopeSkipEx
        android:id="@+id/sport_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.ty.bus.multi.core.view.doublesport.DoubleSportSportView
        android:id="@+id/overLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="view_sport_result" />

    <com.ty.bus.multi.core.view.doublesport.DoubleSportResultView
        android:id="@+id/view_sport_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--  左边无绳提示  -->
    <LinearLayout
        android:id="@+id/ll_tips"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_96"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="@dimen/dp_400"
        android:layout_marginTop="@dimen/dp_100"
        android:background="@drawable/shape_toast_radius"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_48"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_tips"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/ic_tips_face_id" />

        <TextView
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/jump_with_rope"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_36" />
    </LinearLayout>

    <!--  右边无绳提示  -->
    <LinearLayout
        android:id="@+id/ll_tips_right"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_96"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_100"
        android:layout_marginRight="@dimen/dp_400"
        android:background="@drawable/shape_toast_radius"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_48"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_tips_right"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/ic_tips_face_id" />

        <TextView
            android:id="@+id/tv_tips_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/jump_with_rope"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_36" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>