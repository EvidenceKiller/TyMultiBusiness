<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B2000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_700"
        android:background="@mipmap/bg_cpt_resultpage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientLeftView
        android:id="@+id/sg_left"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintRight_toLeftOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />

    <com.ty.tybusbase.view.MyLinerGradientTextVIewType2
        android:id="@+id/mtv_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_90"
        android:text="@string/complete_competition"
        android:textSize="@dimen/sp_120"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientRightView
        android:id="@+id/sg_right"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintLeft_toRightOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_result1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_503"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rv_result2"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_ten_sport_result" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_result2"
        android:layout_width="@dimen/dp_869"
        android:layout_height="@dimen/dp_503"
        app:layout_constraintWidth_percent="0.5"
        android:layout_marginLeft="@dimen/dp_49"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rv_result1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_ten_sport_result2" />

    <TextView
        android:id="@+id/tv_confirm"
        android:layout_width="@dimen/dp_310"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="@dimen/dp_71"
        android:layout_marginBottom="@dimen/dp_90"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:paddingBottom="@dimen/dp_5"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_next" />

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="@dimen/dp_310"
        android:layout_height="@dimen/dp_70"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_71"
        android:layout_marginBottom="@dimen/dp_90"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:paddingBottom="@dimen/dp_5"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_confirm"
        app:layout_constraintRight_toLeftOf="@+id/ll_speech"
        tools:text="下一组" />

    <LinearLayout
        android:id="@+id/ll_speech"
        android:layout_width="@dimen/dp_310"
        android:layout_height="@dimen/dp_70"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_90"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_next"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/iv_player_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="@mipmap/video_ic_stop_default" />

        <TextView
            android:id="@+id/tv_speech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause_result_speech"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>


    <TextView
        android:id="@+id/tv_auto_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_90"
        android:text="@string/auto_next"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cb_auto_next" />

    <CheckBox
        android:id="@+id/cb_auto_next"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_45"
        android:layout_marginEnd="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_90"
        android:background="@drawable/selector_switch"
        android:button="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_auto_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="cb_auto_next,tv_auto_next" />

</androidx.constraintlayout.widget.ConstraintLayout>