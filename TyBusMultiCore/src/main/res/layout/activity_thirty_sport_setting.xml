<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.adl.lib.AdlCameraPreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_view"
        app:layout_constraintLeft_toLeftOf="@+id/preview_view"
        app:layout_constraintRight_toRightOf="@+id/preview_view"
        app:layout_constraintTop_toTopOf="@+id/preview_view">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.73" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.472" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <View
            android:layout_width="@dimen/dp_3"
            android:layout_height="match_parent"
            android:background="@drawable/setting_bg_dash_gap_bg_vertical"
            app:layout_constraintLeft_toLeftOf="@+id/gl3"
            app:layout_constraintRight_toRightOf="@+id/gl3"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.adl.base.overlay.SportOverlayMultiRegion
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/iv_back"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_40"
        android:background="@mipmap/icon_back_in_unitest"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="@dimen/dp_180"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_34"
        android:background="@drawable/setting_bg_common_btn_r25"
        android:text="@string/save_setting"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="@+id/iv_back" />

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_34"
        android:background="@drawable/setting_bg_common_btn_r25"
        android:text="@string/reset"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/btn_save"
        app:layout_constraintTop_toTopOf="@+id/iv_back" />

    <!-- 区域切换下拉框：圆角渐变背景，文字与"保存设置"一致，右侧箭头随展开/收起切换 -->
    <LinearLayout
        android:id="@+id/ll_area_selector"
        android:layout_width="@dimen/dp_350"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:background="@drawable/setting_bg_common_btn_r25"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_20"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_area_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_28" />

        <ImageView
            android:id="@+id/iv_area_arrow"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginLeft="@dimen/dp_8"
            android:contentDescription="@null"
            android:src="@drawable/ic_area_arrow_down" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>