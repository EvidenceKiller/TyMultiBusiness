<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ty.bus.multi.core.view.forwardflexion.ForwardFlexionScoreView
        android:id="@+id/ff_score_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_160"
        android:layout_marginTop="@dimen/dp_128"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.forwardflexion.ForwardFlexionScoreView
        android:id="@+id/ff_score_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ff_score_1" />


    <com.ty.bus.multi.core.view.forwardflexion.ForwardFlexionScoreView
        android:id="@+id/ff_score_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_160"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ff_score_1" />

</androidx.constraintlayout.widget.ConstraintLayout>