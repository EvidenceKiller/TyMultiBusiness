<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_432"
    android:layout_height="@dimen/dp_220"
    android:background="@mipmap/bg_more_landscape_card_empty">

    <TextView
        android:id="@+id/tv_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_4"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- 空闲 -->
    <TextView
        android:id="@+id/tv_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_87"
        android:layout_marginEnd="@dimen/dp_95"
        android:text="@string/idle_state"
        android:textColor="@color/white_60"
        android:textFontWeight="600"
        android:textSize="@dimen/dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_state" />

    <!-- 识别中。。。 -->
    <TextView
        android:id="@+id/tv_identifying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white_80"
        android:textSize="@dimen/sp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_identifying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_identifying" />


    <!--    已识别/已准备  -->
    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_header"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name" />

    <ImageView
        android:id="@+id/iv_header_bg"
        android:layout_width="@dimen/dp_186"
        android:layout_height="@dimen/dp_186"
        android:background="@mipmap/icon_header_bg_vip"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header"
        app:layout_constraintEnd_toEndOf="@+id/iv_header"
        app:layout_constraintStart_toStartOf="@+id/iv_header"
        app:layout_constraintTop_toTopOf="@+id/iv_header" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_20"
        android:ellipsize="end"
        android:maxEms="5"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textFontWeight="500"
        android:textSize="@dimen/sp_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="都说了咖啡店就开了" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_account_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_name,iv_header" />

    <TextView
        android:id="@+id/tv_please_prepare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_36"
        android:text="@string/lie_supine_ready"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--  已识别，请准备  -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_identified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_please_prepare" />


    <TextView
        android:id="@+id/tv_prepared"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_85"
        android:layout_marginBottom="@dimen/dp_28"
        android:background="@drawable/bg_ten_situp_sport_prepared"
        android:gravity="center"
        android:text="@string/prepared"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_48"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!--  已准备  -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_prepared"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_prepared" />

</androidx.constraintlayout.widget.ConstraintLayout>