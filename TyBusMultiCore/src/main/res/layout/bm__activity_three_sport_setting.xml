<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">

    <com.ty.tybusbase.camera.BSCameraPreview
        android:id="@+id/camera_view"
        android:layout_width="@dimen/dp_1920"
        android:layout_height="@dimen/dp_1080"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/setting_bg_dash_gap_bg_vertical"
        android:layout_width="@dimen/dp_3"
        android:layout_height="match_parent"/>

    <com.adl.base.overlay.SportOverlayMultiRegion
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />




    <Button
        android:id="@+id/iv_back"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginLeft="@dimen/dp_40"
        android:background="@mipmap/icon_back_in_unitest" />


    <Button
        android:id="@+id/btn_save"
        android:layout_width="@dimen/dp_180"
        android:layout_height="@dimen/dp_50"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        android:layout_marginLeft="@dimen/dp_34"
        android:textSize="@dimen/dp_28"
        android:textColor="@color/white"
        android:text="@string/save_setting"
        android:background="@drawable/setting_bg_common_btn_r25"/>

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_50"
        app:layout_constraintTop_toTopOf="@+id/iv_back"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintLeft_toRightOf="@+id/btn_save"
        android:layout_marginLeft="@dimen/dp_34"
        android:textSize="@dimen/dp_28"
        android:textColor="@color/white"
        android:text="@string/reset"
        android:background="@drawable/setting_bg_common_btn_r25"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/busi_multi_prompt_align_mat_to_edge"
        android:textSize="@dimen/sp_32"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/dp_40"
        app:layout_constraintLeft_toLeftOf="@+id/iv_back"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>

</androidx.constraintlayout.widget.ConstraintLayout>