<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 6个道次卡片：整体在父容器中垂直居中（左区/中区/右区各6人） -->
    <LinearLayout
        android:id="@+id/ll_cards_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_40"
                app:pk_index="1" />

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_40"
                app:pk_index="2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_40"
                app:pk_index="3" />

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_40"
                app:pk_index="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_40"
                app:pk_index="5" />

            <com.ty.bus.multi.core.view.sixsitreach.SitReachSportCardView
                android:id="@+id/ffs_sport_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_40"
                app:pk_index="6" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
