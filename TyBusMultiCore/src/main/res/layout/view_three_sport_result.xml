<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B2000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_628"
        android:background="@mipmap/bg_cpt_resultpage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientLeftView
        android:id="@+id/sg_left"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintRight_toLeftOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />

    <com.ty.tybusbase.view.MyLinerGradientTextVIewType2
        android:id="@+id/mtv_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_90"
        android:text="@string/complete_competition"
        android:textSize="@dimen/sp_120"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientRightView
        android:id="@+id/sg_right"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintLeft_toRightOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />


    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_120"
        app:layout_constraintRight_toLeftOf="@+id/srv_number2"
        app:layout_constraintTop_toTopOf="@+id/srv_number2" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_320"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_120"
        app:layout_constraintLeft_toRightOf="@+id/srv_number2"
        app:layout_constraintTop_toTopOf="@+id/srv_number2" />


    <TextView
        android:id="@+id/tv_retest"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginBottom="@dimen/dp_120"
        android:background="@drawable/bg_btn_white_r50"
        android:gravity="center"
        android:text="@string/retest"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_next"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_60"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/tv_finish"
        app:layout_constraintStart_toEndOf="@+id/tv_retest"
        app:layout_constraintTop_toTopOf="@+id/tv_retest" />


    <TextView
        android:id="@+id/tv_finish"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_60"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/end_test"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_next"
        app:layout_constraintTop_toTopOf="@+id/tv_retest" />

</androidx.constraintlayout.widget.ConstraintLayout>