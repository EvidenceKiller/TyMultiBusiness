<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_1728"
    android:layout_height="@dimen/dp_920"
    android:background="#124A9E">

    <com.ty.tybusbase.view.SlidingTabLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tl_iconHeight="@dimen/dp_50"
        app:tl_iconVisible="false"
        app:tl_iconWidth="@dimen/dp_50"
        app:tl_indicator_color="#E94C71"
        app:tl_indicator_corner_radius="@dimen/dp_2"
        app:tl_indicator_gravity="BOTTOM"
        app:tl_indicator_height="@dimen/dp_6"
        app:tl_indicator_margin_bottom="@dimen/dp_0_5"
        app:tl_indicator_width="@dimen/dp_80"
        app:tl_select_textsize="@dimen/dp_40"
        app:tl_tab_width="@dimen/dp_200"
        app:tl_text_gravity="BOTTOM"
        app:tl_textsize="@dimen/sp_32"
        app:tl_unselect_textsize="@dimen/sp_28" />

    <View
        android:id="@+id/view_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_90"
        android:background="@color/white_40"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_grade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_grade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_32"
        app:cardBackgroundColor="#992572FF"
        app:cardCornerRadius="@dimen/dp_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_24">

            <ImageView
                android:id="@+id/iv_mmjj"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginVertical="@dimen/dp_17"
                android:background="@mipmap/icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_grade_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_mmjj"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_student"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_bg"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv_grade"
        tools:itemCount="3"
        tools:listitem="@layout/bm_item_choose_student" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_class"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="rv_student,cv_grade" />

    <ImageView
        android:id="@+id/iv_search_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#124A9E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider" />

    <androidx.cardview.widget.CardView
        android:id="@+id/input_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_50"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_38"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:cardBackgroundColor="#4D7EB5FF"
        app:cardCornerRadius="@dimen/dp_50"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginLeft="@dimen/dp_30"
                android:background="@mipmap/busi_base_ic_serach" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_18"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/busi_multi_input_name_search"
                android:imeOptions="flagNoExtractUi"
                android:maxLength="20"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="#66FFFFFF"
                android:textSize="@dimen/sp_20" />

            <ImageView
                android:id="@+id/iv_clear_all"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:layout_marginLeft="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_24"
                android:background="@mipmap/close_click" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_student"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_card"
        tools:itemCount="3"
        tools:listitem="@layout/bm_item_choose_student" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_search_student"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="rv_search_student,input_card,iv_search_bg" />

    <ImageView
        android:id="@+id/iv_no_user"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_200"
        android:layout_marginBottom="@dimen/dp_20"
        android:background="@mipmap/busi_base_ic_no_data"
        app:layout_constraintBottom_toTopOf="@+id/tv_no_user"
        app:layout_constraintEnd_toStartOf="@id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_no_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_238"
        android:gravity="center_horizontal"
        android:lineHeight="@dimen/dp_32"
        android:text="@string/busi_multi_search_no_student"
        android:textColor="@color/white_80"
        android:textSize="@dimen/sp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_right_bg"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_no_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_no_user,tv_no_user" />

    <ImageView
        android:id="@+id/iv_right_bg"
        android:layout_width="@dimen/dp_549"
        android:layout_height="match_parent"
        android:background="#256DCF"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_confirm"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_54"
        android:layout_marginBottom="@dimen/dp_20"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@drawable/bg_border_r50_white_shape"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintEnd_toStartOf="@+id/tv_confirm"
        app:layout_constraintTop_toTopOf="@+id/tv_confirm" />

    <TextView
        android:id="@+id/tv_index1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_444"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/ll_add1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_add1" />

    <LinearLayout
        android:id="@+id/ll_add1"
        android:layout_width="@dimen/dp_384"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@drawable/bg_border_dashed_r5_white_shape"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_add1_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="@mipmap/sports_ic_adduser" />

        <TextView
            android:id="@+id/tv_add1_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="@string/tj"
            android:textColor="@color/white_80"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_add1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ll_add1,tv_index1" />
    <!--  一号位识别到人的UI  -->
    <ImageView
        android:id="@+id/iv_added_bg1"
        android:layout_width="@dimen/dp_501"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_24"
        android:background="@mipmap/bg_blue_user_added"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_index1"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66"
        android:layout_marginStart="@dimen/dp_15"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg1"
        app:layout_constraintStart_toStartOf="@+id/iv_added_bg1"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg1" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_header1"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_add_index1"
        app:layout_constraintStart_toEndOf="@+id/tv_add_index1"
        app:layout_constraintTop_toTopOf="@+id/tv_add_index1" />

    <TextView
        android:id="@+id/tv_add_name1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_33"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header1"
        app:layout_constraintStart_toEndOf="@+id/iv_header1"
        app:layout_constraintTop_toTopOf="@+id/iv_header1" />

    <ImageView
        android:id="@+id/iv_delete_user1"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@mipmap/ic_delete"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg1"
        app:layout_constraintEnd_toEndOf="@+id/iv_added_bg1"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg1" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_added_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_added_bg1,tv_add_name1,iv_delete_user1,tv_add_index1,iv_header1" />

    <!--  2号位  -->
    <TextView
        android:id="@+id/tv_index2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_444"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/ll_add2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_add2" />

    <LinearLayout
        android:id="@+id/ll_add2"
        android:layout_width="@dimen/dp_384"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@drawable/bg_border_dashed_r5_white_shape"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_add1">

        <ImageView
            android:id="@+id/iv_add2_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="@mipmap/sports_ic_adduser" />

        <TextView
            android:id="@+id/tv_add2_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="@string/tj"
            android:textColor="@color/white_80"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_add2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ll_add2,tv_index2" />
    <!--  2号位已识别  -->
    <ImageView
        android:id="@+id/iv_added_bg2"
        android:layout_width="@dimen/dp_501"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_220"
        android:layout_marginEnd="@dimen/dp_24"
        android:background="@mipmap/bg_blue_user_added"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_index2"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66"
        android:layout_marginStart="@dimen/dp_15"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg2"
        app:layout_constraintStart_toStartOf="@+id/iv_added_bg2"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg2" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_header2"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg2"
        app:layout_constraintStart_toEndOf="@+id/tv_add_index2"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg2" />

    <TextView
        android:id="@+id/tv_add_name2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_33"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg2"
        app:layout_constraintStart_toEndOf="@+id/iv_header2"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg2" />

    <ImageView
        android:id="@+id/iv_delete_user2"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@mipmap/ic_delete"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg2"
        app:layout_constraintEnd_toEndOf="@+id/iv_added_bg2"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg2" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_added_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_added_bg2,tv_add_name2,iv_delete_user2,tv_add_index2,iv_header2" />


    <!--  3号位  -->
    <TextView
        android:id="@+id/tv_index3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_444"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/ll_add3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_add3" />

    <LinearLayout
        android:id="@+id/ll_add3"
        android:layout_width="@dimen/dp_384"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@drawable/bg_border_dashed_r5_white_shape"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_add2">

        <ImageView
            android:id="@+id/iv_add3_icon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="@mipmap/sports_ic_adduser" />

        <TextView
            android:id="@+id/tv_add3_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="@string/tj"
            android:textColor="@color/white_80"
            android:textSize="@dimen/sp_28" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_add3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ll_add3,tv_index3" />

    <!--  3号位已识别  -->
    <ImageView
        android:id="@+id/iv_added_bg3"
        android:layout_width="@dimen/dp_501"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_380"
        android:layout_marginEnd="@dimen/dp_24"
        android:background="@mipmap/bg_blue_user_added"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_add_index3"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_66"
        android:layout_marginStart="@dimen/dp_15"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_56"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg3"
        app:layout_constraintStart_toStartOf="@+id/iv_added_bg3"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg3" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_header3"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg3"
        app:layout_constraintStart_toEndOf="@+id/tv_add_index3"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg3" />

    <TextView
        android:id="@+id/tv_add_name3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_33"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg3"
        app:layout_constraintStart_toEndOf="@+id/iv_header3"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg3" />

    <ImageView
        android:id="@+id/iv_delete_user3"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@mipmap/ic_delete"
        app:layout_constraintBottom_toBottomOf="@+id/iv_added_bg3"
        app:layout_constraintEnd_toEndOf="@+id/iv_added_bg3"
        app:layout_constraintTop_toTopOf="@+id/iv_added_bg3" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_added_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_added_bg3,tv_add_name3,iv_delete_user3,tv_add_index3,iv_header3" />

</androidx.constraintlayout.widget.ConstraintLayout>