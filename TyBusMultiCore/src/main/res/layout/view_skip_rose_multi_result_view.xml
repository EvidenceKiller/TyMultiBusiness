<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B2000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_628"
        android:background="@mipmap/bg_cpt_resultpage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientLeftView
        android:id="@+id/sg_left"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintRight_toLeftOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />

    <com.ty.tybusbase.view.MyLinerGradientTextVIewType2
        android:id="@+id/mtv_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_90"
        android:text="@string/complete_competition"
        android:textSize="@dimen/sp_120"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SkipMultiGradientRightView
        android:id="@+id/sg_right"
        android:layout_width="@dimen/dp_720"
        android:layout_height="@dimen/dp_4"
        android:layout_marginLeft="@dimen/dp_28"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_finish"
        app:layout_constraintLeft_toRightOf="@+id/mtv_finish"
        app:layout_constraintTop_toTopOf="@+id/mtv_finish" />

    <!--  结果卡片区  -->
    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_145"
        android:layout_marginTop="@dimen/dp_320"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/srv_number2"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/srv_number1"
        app:layout_constraintRight_toLeftOf="@+id/srv_number3"
        app:layout_constraintTop_toTopOf="@+id/srv_number1" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/srv_number2"
        app:layout_constraintRight_toLeftOf="@+id/srv_number4"
        app:layout_constraintTop_toTopOf="@+id/srv_number1" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/srv_number3"
        app:layout_constraintRight_toLeftOf="@+id/srv_number5"
        app:layout_constraintTop_toTopOf="@+id/srv_number1" />

    <com.ty.bus.multi.core.view.common.SportCardResultView
        android:id="@+id/srv_number5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_145"
        app:layout_constraintLeft_toRightOf="@+id/srv_number4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/srv_number1" />


    <TextView
        android:id="@+id/tv_confirm"
        android:layout_width="@dimen/dp_410"
        android:layout_height="@dimen/dp_70"
        android:layout_marginTop="@dimen/dp_71"
        android:layout_marginBottom="@dimen/dp_90"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:paddingBottom="@dimen/dp_5"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>