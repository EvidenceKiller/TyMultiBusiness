<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ty.tybusbase.view.MyLinerGradientTextVIewType1
        android:id="@+id/tv_count_down_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        android:textSize="@dimen/dp_64"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_start_now"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="竞技开始咯" />

    <TextView
        android:id="@+id/tv_start_now"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_round_r50_gradient_red"
        android:gravity="center"
        android:text="@string/start_now"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tv_count_down_notice"
        app:layout_constraintLeft_toRightOf="@+id/tv_count_down_notice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_count_down_notice" />

    <LinearLayout
        android:id="@+id/ll_time"
        android:layout_width="@dimen/dp_358"
        android:layout_height="@dimen/dp_96"
        android:background="@mipmap/pic_time_default_more"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_time_icon"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/icon_time_countdown" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_56" />

    </LinearLayout>

    <!-- 10个道次卡片：整体在剩余空间中垂直居中 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_cards_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_145"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_145"
            app:layout_constraintEnd_toEndOf="@+id/ml_sport_view_4"
            app:layout_constraintStart_toStartOf="@+id/ml_sport_view_4"
            app:layout_constraintTop_toTopOf="parent"
            app:pk_index="1" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/ml_sport_view_5"
            app:layout_constraintStart_toStartOf="@+id/ml_sport_view_5"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_1"
            app:pk_index="2" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_32"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ml_sport_view_1"
            app:pk_index="3" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_5"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_3"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_3"
            app:pk_index="4" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_6"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_4"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_3"
            app:pk_index="5" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_5"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_3"
            app:pk_index="6" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_32"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ml_sport_view_3"
            app:pk_index="7" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_9"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_7"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_7"
            app:pk_index="8" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/ml_sport_view_10"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_8"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_7"
            app:pk_index="9" />

        <com.ty.bus.multi.core.view.common.MoreLandscapeSportCardSportView
            android:id="@+id/ml_sport_view_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_60"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ml_sport_view_9"
            app:layout_constraintTop_toTopOf="@+id/ml_sport_view_7"
            app:pk_index="10" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_count_down_go"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_50"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textFontWeight="600"
        android:textSize="@dimen/dp_400"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
