<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.ty.bus.multi.core.view.common.FourSportCardSportView
        android:id="@+id/sport_view1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/sport_view2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sport_index="1" />

    <com.ty.bus.multi.core.view.common.FourSportCardSportView
        android:id="@+id/sport_view2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_64"
        app:layout_constraintBottom_toBottomOf="@+id/sport_view1"
        app:layout_constraintEnd_toStartOf="@+id/sport_view3"
        app:layout_constraintStart_toEndOf="@+id/sport_view1"
        app:layout_constraintTop_toTopOf="@+id/sport_view1"
        app:sport_index="2" />

    <com.ty.bus.multi.core.view.common.FourSportCardSportView
        android:id="@+id/sport_view3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_64"
        app:layout_constraintBottom_toBottomOf="@+id/sport_view1"
        app:layout_constraintEnd_toStartOf="@+id/sport_view4"
        app:layout_constraintStart_toEndOf="@+id/sport_view2"
        app:layout_constraintTop_toTopOf="@+id/sport_view1"
        app:sport_index="3" />

    <com.ty.bus.multi.core.view.common.FourSportCardSportView
        android:id="@+id/sport_view4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_64"
        app:layout_constraintBottom_toBottomOf="@+id/sport_view1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sport_view3"
        app:layout_constraintTop_toTopOf="@+id/sport_view1"
        app:sport_index="4" />

</androidx.constraintlayout.widget.ConstraintLayout>