<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_new_all">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_45"
        android:text="BMI"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_56"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_number_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_208"
        android:text="1号位"
        android:layout_marginStart="@dimen/dp_60"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_ble_1"
        android:layout_width="@dimen/dp_600"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_blue_address"
        android:gravity="center"
        android:text="@string/busi_multi_click_add_bluetooth"
        android:textColor="@color/white_60"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_number_1"
        app:layout_constraintStart_toEndOf="@+id/tv_number_1"
        app:layout_constraintTop_toTopOf="@+id/tv_number_1" />

    <TextView
        android:id="@+id/tv_ble_disconnect_1"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_ff685d_r10"
        android:gravity="center"
        android:text="断开连接"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ble_1"
        app:layout_constraintStart_toEndOf="@+id/tv_ble_1"
        app:layout_constraintTop_toTopOf="@+id/tv_ble_1" />


    <TextView
        android:id="@+id/tv_number_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="2号位"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="@+id/tv_number_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_number_1" />

    <TextView
        android:id="@+id/tv_ble_2"
        android:layout_width="@dimen/dp_600"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_blue_address"
        android:gravity="center"
        android:text="@string/busi_multi_click_add_bluetooth"
        android:textColor="@color/white_60"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_number_2"
        app:layout_constraintStart_toEndOf="@+id/tv_number_2"
        app:layout_constraintTop_toTopOf="@+id/tv_number_2" />

    <TextView
        android:id="@+id/tv_ble_disconnect_2"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_ff685d_r10"
        android:gravity="center"
        android:text="断开连接"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ble_2"
        app:layout_constraintStart_toEndOf="@+id/tv_ble_2"
        app:layout_constraintTop_toTopOf="@+id/tv_ble_2" />

    <TextView
        android:id="@+id/tv_number_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="3号位"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="@+id/tv_number_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_number_2" />

    <TextView
        android:id="@+id/tv_ble_3"
        android:layout_width="@dimen/dp_600"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_blue_address"
        android:gravity="center"
        android:text="@string/busi_multi_click_add_bluetooth"
        android:textColor="@color/white_60"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_number_3"
        app:layout_constraintStart_toEndOf="@+id/tv_number_3"
        app:layout_constraintTop_toTopOf="@+id/tv_number_3" />

    <TextView
        android:id="@+id/tv_ble_disconnect_3"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_72"
        android:layout_marginStart="@dimen/dp_30"
        android:background="@drawable/bg_ff685d_r10"
        android:gravity="center"
        android:text="断开连接"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ble_3"
        app:layout_constraintStart_toEndOf="@+id/tv_ble_3"
        app:layout_constraintTop_toTopOf="@+id/tv_ble_3" />

    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_60"
        android:layout_marginStart="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_60"
        android:alpha="0.6"
        android:background="@drawable/gradient_2b000000_000000"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_28"
            android:background="@mipmap/icon_back" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>