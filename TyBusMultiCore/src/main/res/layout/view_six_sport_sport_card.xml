<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dp_756"
    android:layout_height="@dimen/dp_216">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/bg_card_ready_nouser" />

    <TextView
        android:id="@+id/tv_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_20"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/dp_16"
        app:layout_goneMarginTop="@dimen/dp_4" />

    <!--无人状态-->
    <TextView
        android:id="@+id/tv_state"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_55"
        android:background="@drawable/pk_skip_rose_card_state_shape"
        android:gravity="center"
        android:text="@string/idle_state"
        android:textColor="@color/white_60"
        android:textFontWeight="600"
        android:textSize="@dimen/dp_24"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_idle_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_48"
        android:text="@string/forward_flexion_identified_tip"
        android:textColor="@color/white_60"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_state,tv_idle_tips" />

    <!--  识别中状态  -->
    <com.ty.tybusbase.view.ArcCircleProgressView
        android:id="@+id/progress_view"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_96"
        android:layout_marginStart="@dimen/dp_195"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_identify_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_centerInParent="true"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_face_recognition"
        app:layout_constraintBottom_toBottomOf="@+id/progress_view"
        app:layout_constraintLeft_toLeftOf="@+id/progress_view"
        app:layout_constraintRight_toRightOf="@+id/progress_view"
        app:layout_constraintTop_toTopOf="@+id/progress_view" />

    <TextView
        android:id="@+id/tv_identifying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        android:text="@string/identifying"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintBottom_toBottomOf="@id/progress_view"
        app:layout_constraintStart_toEndOf="@+id/progress_view"
        app:layout_constraintTop_toTopOf="@+id/progress_view" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_identifying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_identify_icon,tv_identifying,progress_view" />

    <!--  已识别人员  -->
    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/civ_header"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56"
        android:layout_marginStart="@dimen/dp_102"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@mipmap/ic_head_default"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="@+id/civ_header"
        app:layout_constraintStart_toEndOf="@+id/civ_header"
        app:layout_constraintTop_toTopOf="@+id/civ_header"
        tools:text="刘玉杭" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_account_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_name,civ_header" />

    <!--  已识别后准备提示  -->
    <TextView
        android:id="@+id/tv_identified_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_36"
        android:text="@string/lie_on_back_and_face_screen"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_identified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_identified_tips" />


    <!--  已准备  -->
    <ImageView
        android:id="@+id/iv_prepared_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_106"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_forward_flexion_sport_card_prepared"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tv_prepared_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ready_state"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_64"
        app:layout_constraintBottom_toBottomOf="@+id/iv_prepared_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_prepared_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_prepared_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_prepared_bg" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_prepared"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="iv_prepared_bg,tv_prepared_tips" />

    <!--运动开始，无人-->
    <TextView
        android:id="@+id/tv_start_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_427"
        android:text="@string/idle_state"
        android:textColor="@color/white_60"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_start_no_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_start_tips" />

    <!-- 运动状态 -->
    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/civ_result_header"
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_56"
        android:layout_marginStart="@dimen/dp_102"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_result_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="@+id/civ_result_header"
        app:layout_constraintStart_toEndOf="@+id/civ_result_header"
        app:layout_constraintTop_toTopOf="@+id/civ_result_header" />

    <ImageView
        android:id="@+id/iv_sport_arrow"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_162"
        android:visibility="gone"
        android:background="@mipmap/ic_this_result"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_result_name"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_sport_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_112"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_88"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="88" />

    <TextView
        android:id="@+id/tv_result_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:textColor="@color/white_80"
        android:textSize="@dimen/sp_40"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sport_result"
        app:layout_constraintStart_toEndOf="@+id/tv_sport_result"
        tools:text="个" />

    <!--  数据结果，运动过程中也展示  -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_result_unit,tv_sport_result,tv_result_name,civ_result_header" />

    <ImageView
        android:id="@+id/iv_sporting_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sit_up_6_result_mask_shape"/>

    <TextView
        android:id="@+id/tv_sporting_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:textColor="@color/white_80"
        android:textSize="@dimen/sp_32"
        app:layout_constraintEnd_toStartOf="@+id/civ_sporting_result_header"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/civ_sporting_result_header"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sporting_index"
        app:layout_constraintEnd_toStartOf="@+id/tv_sporting_result_name"
        app:layout_constraintStart_toEndOf="@+id/tv_sporting_index"
        app:layout_constraintTop_toTopOf="@+id/tv_sporting_index" />

    <TextView
        android:id="@+id/tv_sporting_result_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:textColor="@color/white_80"
        android:textSize="@dimen/sp_32"
        app:layout_constraintBottom_toBottomOf="@+id/civ_sporting_result_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/civ_sporting_result_header"
        app:layout_constraintTop_toTopOf="@+id/civ_sporting_result_header" />

    <TextView
        android:id="@+id/tv_sporting_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_18"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_88"
        android:text="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_sporting_unit"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_sporting_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:text="@string/ge"
        android:textSize="@dimen/sp_48"
        android:textColor="@color/white_80"
        app:layout_constraintBottom_toBottomOf="@+id/tv_sporting_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_sporting_result" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_sport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_sporting_index,tv_sporting_unit,tv_sporting_result,tv_sporting_result_name,civ_sporting_result_header,iv_sporting_mask" />


</androidx.constraintlayout.widget.ConstraintLayout>