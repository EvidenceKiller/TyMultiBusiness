<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_right_win"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_70">

    <View
        android:id="@+id/rw_bg"
        android:layout_width="@dimen/dp_1052"
        android:layout_height="@dimen/dp_534"
        android:layout_marginTop="@dimen/dp_207"
        android:background="@mipmap/bg_win1right"
        android:visibility="visible"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_head_rw"
        android:layout_width="@dimen/dp_195"
        android:layout_height="@dimen/dp_195"
        android:layout_marginLeft="@dimen/dp_416"
        android:layout_marginBottom="@dimen/dp_221"
        android:src="@mipmap/ic_head_default"
        app:border_color="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/rw_bg"
        app:layout_constraintStart_toStartOf="@+id/rw_bg" />

    <ImageView
        android:id="@+id/iv_header_bg_rw"
        android:layout_width="@dimen/dp_294"
        android:layout_height="@dimen/dp_294"
        android:background="@mipmap/icon_header_bg_vip"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head_rw"
        app:layout_constraintEnd_toEndOf="@+id/iv_head_rw"
        app:layout_constraintStart_toStartOf="@+id/iv_head_rw"
        app:layout_constraintTop_toTopOf="@+id/iv_head_rw" />

    <include
        android:id="@+id/layout_energy_rw"
        layout="@layout/base_layout_energy_icon"
        android:layout_width="@dimen/dp_110"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_150"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="@+id/iv_head_rw"
        app:layout_constraintTop_toTopOf="@+id/iv_head_rw" />

    <TextView
        android:id="@+id/tv_name_rw"
        android:layout_width="@dimen/dp_254"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_174"
        android:background="@drawable/bg_round_gradient_blue"
        android:gravity="center"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/white"
        android:textSize="@dimen/sp_52"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/rw_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_head_rw"
        app:layout_constraintRight_toRightOf="@+id/iv_head_rw" />

    <TextView
        android:id="@+id/tv_score_rw"
        android:layout_width="@dimen/dp_362"
        android:layout_height="@dimen/dp_102"
        android:layout_marginBottom="@dimen/dp_40"
        android:gravity="center"
        android:text="12"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_76"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/rw_bg"
        app:layout_constraintEnd_toEndOf="@id/rw_bg"
        app:layout_constraintStart_toStartOf="@+id/rw_bg" />

    <View
        android:id="@+id/ll_bg"
        android:layout_width="@dimen/dp_1040"
        android:layout_height="@dimen/dp_453"
        android:layout_marginTop="@dimen/dp_352"
        android:background="@mipmap/bg_lose1left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ty.tybusbase.view.CircleImageView
        android:id="@+id/iv_head_ll"
        android:layout_width="@dimen/dp_195"
        android:layout_height="@dimen/dp_195"
        android:layout_marginLeft="@dimen/dp_365"
        android:layout_marginTop="@dimen/dp_84"
        android:src="@mipmap/ic_head_default"
        app:border_color="@color/white"
        app:layout_constraintStart_toStartOf="@+id/ll_bg"
        app:layout_constraintTop_toTopOf="@id/ll_bg" />

    <ImageView
        android:id="@+id/iv_header_bg_ll"
        android:layout_width="@dimen/dp_294"
        android:layout_height="@dimen/dp_294"
        android:background="@mipmap/icon_header_bg_vip"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head_ll"
        app:layout_constraintEnd_toEndOf="@+id/iv_head_ll"
        app:layout_constraintStart_toStartOf="@+id/iv_head_ll"
        app:layout_constraintTop_toTopOf="@+id/iv_head_ll" />

    <include
        android:id="@+id/layout_energy_ll"
        layout="@layout/base_layout_energy_icon"
        android:layout_width="@dimen/dp_110"
        android:layout_height="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_150"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintStart_toStartOf="@+id/iv_head_ll"
        app:layout_constraintTop_toTopOf="@+id/iv_head_ll" />

    <TextView
        android:id="@+id/tv_name_ll"
        android:layout_width="@dimen/dp_254"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_263"
        android:background="@drawable/bg_round_gradient_gray"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_52"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="@+id/iv_head_ll"
        app:layout_constraintRight_toRightOf="@+id/iv_head_ll"
        app:layout_constraintTop_toTopOf="@id/ll_bg" />

    <TextView
        android:id="@+id/tv_score_ll"
        android:layout_width="@dimen/dp_362"
        android:layout_height="@dimen/dp_102"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/dp_292"
        android:layout_marginBottom="@dimen/dp_40"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_76"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ll_bg"
        app:layout_constraintStart_toStartOf="@+id/ll_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>
