    <!-- ========== 第一层：渐变边框（真正的渐变） ========== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#331D81E4"
                android:endColor="#9ECFFF"
                android:startColor="#B0D8FF" />
            <corners android:radius="@dimen/dp_40" />
        </shape>
    </item>

    <item
        android:bottom="@dimen/dp_1"
        android:left="@dimen/dp_1"
        android:right="@dimen/dp_1"
        android:top="@dimen/dp_1">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <!-- 背景渐变，对应 #0062C3 → #0565FF -->
            <gradient
                android:angle="0"
                android:endColor="#660565FF"
                android:startColor="#CC0062C3" />
            <corners android:radius="@dimen/dp_40" />
        </shape>
    </item>

</layer-list>