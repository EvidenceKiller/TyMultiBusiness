<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_70">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_462"
        android:background="@mipmap/finish_sport" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_580"
        android:layout_marginTop="@dimen/dp_308"
        android:background="@color/black_cc" />

    <View
        android:layout_width="@dimen/dp_540"
        android:layout_height="@dimen/dp_540"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_290"
        android:background="@mipmap/bg_sport_score" />


    <TextView
        android:id="@+id/sport_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_478"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_94"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sport_dw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_582"
        android:text="@string/ge"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_54"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sport_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_170"
        android:layout_marginTop="@dimen/dp_350"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_80"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_170"
        android:layout_marginTop="@dimen/dp_573"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_result"
            android:textColor="@color/white_80"
            android:textSize="@dimen/sp_28" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_40"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_52"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_170"
        android:layout_marginTop="@dimen/dp_642"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sport_duration"
            android:textColor="@color/white_80"
            android:textSize="@dimen/sp_28" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_40"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_52"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_sure"
        android:layout_width="@dimen/dp_361"
        android:layout_height="@dimen/dp_80"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_960"
        android:background="@drawable/bg_go_on"
        android:gravity="center"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_28" />

</RelativeLayout>
