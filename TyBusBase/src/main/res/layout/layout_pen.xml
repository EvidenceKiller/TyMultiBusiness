<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_248"
    android:orientation="vertical"
    android:background="@mipmap/popover_pen_bg"
    android:layout_height="@dimen/dp_179">

    <LinearLayout
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15">

        <ImageView
            android:id="@+id/btn_pen_small"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_32"
            android:layout_weight="1"
            android:src="@drawable/select_pen_small" />

        <ImageView
            android:id="@+id/btn_pen_middle"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_32"
            android:layout_weight="1"
            android:src="@drawable/select_pen_middle" />

        <ImageView
            android:id="@+id/btn_pen_large"
            android:layout_width="@dimen/dp_60"
            android:layout_height="@dimen/dp_32"
            android:layout_weight="1"
            android:src="@drawable/select_pen_largel" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_24"
        android:id="@+id/rv_pen_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>