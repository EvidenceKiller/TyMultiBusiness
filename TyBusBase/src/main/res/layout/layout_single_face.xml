<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rl_identity_notice"
        android:layout_width="@dimen/dp_360"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/rect_black_bg">

        <TextView
            android:id="@+id/tv_state_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginRight="@dimen/dp_20"
            android:gravity="center_horizontal"
            android:text="@string/prompt_stand_rect_hand_up"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_40"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_state"
            android:layout_width="@dimen/dp_110"
            android:layout_height="@dimen/dp_110"
            android:layout_below="@+id/tv_state_notice"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_50"
            android:scaleType="fitXY"
            android:src="@mipmap/hand_up_icon" />

        <com.ty.tybusbase.view.ArcCircleProgressView
            android:id="@+id/progress_view"
            android:layout_width="@dimen/dp_130"
            android:layout_height="@dimen/dp_130"
            android:layout_below="@+id/tv_state_notice"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_30" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_area_notice"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_300"
        android:layout_centerInParent="true"
        android:background="@drawable/rect_black_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_area_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="@string/move_to_rect"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_40"
            android:textStyle="bold" />

    </RelativeLayout>

    <ImageView
        android:id="@+id/iv_area_notice"
        android:layout_width="@dimen/dp_432"
        android:layout_height="@dimen/dp_183"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/dp_30"
        android:background="#00000000"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_foot_area" />

    <ImageView
        android:id="@+id/iv_face_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/dp_30"
        android:scaleType="fitXY" />
</merge>