<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp_480"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_rounded_rect_r_20_black_80">

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="@dimen/dp_400"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/ll_btn"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginVertical="@dimen/dp_50"
        android:text="@string/prompt_start_race"
        android:gravity="center"
        android:textSize="@dimen/sp_32"
        android:textColor="@color/white"/>

    <LinearLayout
        android:id="@+id/ll_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_40"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/dp_214"
            android:layout_height="@dimen/dp_74"
            android:background="@drawable/bg_border_r50_white_shape"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_28" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_60"
            android:layout_marginLeft="@dimen/dp_33"
            android:background="@drawable/bg_round_r50_gradient_red"
            android:gravity="center"
            android:text="@string/confirm"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_28" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>