	public USB(Context hostAct)//+2018.12.14
	{
		super();
		int i;
		
		this.hostAct = hostAct;
		
		for(i=0; i< MAX_USB_DEV_SUPPORT; i++)
		{
			//usbDevices_mount[i] = new USBDeviceInfo();
			usbDevices_linked[i] = new USBDeviceInfo();
		}
	}
	
	
	
	public void ClearUSBDeviceInfo(USBDeviceInfo[] pInfo)
	{
		int i;
		
		for(i= 0; i< MAX_USB_DEV_SUPPORT; i++)
		{
			//usbDevices_mount[i].usbHandle = -1;
			pInfo[i].usbHandle = -1;
		}
		
		USBDevicesMountedNum = 0;
	}
	
	public void setDevicePara(int vendorID, int productID)
	{
		m_vendorID = vendorID;
		m_productID = productID;
	}
	
	private int patchUSBDevice(USBDeviceInfo usbInfo)
	{
		int rel = -1;
		int i;
		
		for(i=0; i< MAX_USB_DEV_SUPPORT; i++)
		{
			//if(usbDevices_linked[i].usbHandle != -1)
			{
				if(usbInfo.usbDevPath.equals(usbDevices_linked[i].usbDevPath))
				{
					rel = i;
					break;
				}
			}
		}
		
		return rel;
	}
	private int fillUSBDevice(USBDeviceInfo usbInfo)
	{
		int rel = -1;
		int i;
		
		for(i=0; i< MAX_USB_DEV_SUPPORT; i++)
		{
			//if(usbDevices_linked[i].usbHandle == -1)
			if(usbDevices_linked[i].usbDevPath.equals(""))
			{
				usbDevices_linked[i] = usbInfo;
				usbDevices_linked[i].usbHandle = i+1;
				rel = i + 1;
				break;
			}
		}
		return rel;
	}
	private int ResetDeviceOperating(int usbHandle)
	{
		int rel = -1;
		int i;
		int iHandle;
		
		if( (usbHandle == -1) || (usbHandle >MAX_USB_DEV_SUPPORT) )
			return rel;
		
		rel = usbHandle;
		iHandle = usbHandle -1;
		
		usbDevice = usbDevices_linked[iHandle].usbDevice;
		usbInterface = usbDevices_linked[iHandle].usbInterface;
		connection = usbDevices_linked[iHandle].connection;
		inEndpoint = usbDevices_linked[iHandle].inEndpoint;
		outEndpoint = usbDevices_linked[iHandle].outEndpoint;
		
		//public SerialPort mSerialPort;
		m_OutputStream = usbDevices_linked[iHandle].m_OutputStream;
		m_InputStream = usbDevices_linked[iHandle].m_InputStream;
		
		return rel;	
	}
	/**
	 * 打开usb
	 */
	public int usbOpen() {
		
		PendingIntent pendingIntent;
		IntentFilter filter;
		int RelHandle = -1;
		int i;
		USBDeviceInfo[] usbDevices_mount = new USBDeviceInfo[MAX_USB_DEV_SUPPORT + 1];
		
		//connection1 = null;
		
		if(hostAct == null)
			return -1;
		
		usbManager = (UsbManager) hostAct.getSystemService(Context.USB_SERVICE);
		//usbManager = (UsbManager)getSystemService(mContext.USB_SERVICE);//+2018.12.14
		
		if(usbManager == null)
			return -1;

		try{
			pendingIntent = PendingIntent.getBroadcast(hostAct, 0,
					new Intent(ACTION_USB_PERMISSION), 0);
			filter = new IntentFilter(ACTION_USB_PERMISSION);
		}
		catch(Exception e)
		{
			e.printStackTrace();
			return -1;
		}
		
		try{
			hostAct.registerReceiver(mUsbReceiver, filter);
		}
		catch(Exception e)
		{
			e.printStackTrace();
			return -1;
		}
		
		try{
			hostAct.unregisterReceiver(mUsbReceiver);
		}
		catch(Exception e)
		{
			e.printStackTrace();
			return -1;
		}
		
		for(i=0; i< MAX_USB_DEV_SUPPORT; i++)
		{
			usbDevices_mount[i] = new USBDeviceInfo();
		}
		ClearUSBDeviceInfo(usbDevices_mount);

		try {
			HashMap<String, UsbDevice> map = usbManager.getDeviceList();
			for (UsbDevice device : map.values()) {
				
				if(true == fDebug)
				{
					Log.i("readerlog",
						"vid:" + device.getVendorId() + "   pid:"
								+ device.getProductId() + "   "
								+ device.getDeviceName());
				}
				if (m_vendorID == device.getVendorId()
						&& m_productID == device.getProductId()) {
					
					if(device.getInterfaceCount() > 0)
					{
						if(USBDevicesMountedNum < MAX_USB_DEV_SUPPORT)
						{
							if (usbManager.hasPermission(device) == false) {
								usbManager.requestPermission(device, pendingIntent);
							}							
							
							usbDevices_mount[USBDevicesMountedNum].usbDevPath = device.getDeviceName();
							usbDevices_mount[USBDevicesMountedNum].usbDevice = device;
							usbDevices_mount[USBDevicesMountedNum].usbInterface = device.getInterface(0);
							usbDevices_mount[USBDevicesMountedNum].connection = usbManager.openDevice(device);
							usbDevices_mount[USBDevicesMountedNum].outEndpoint = device.getInterface(0).getEndpoint(1); // write by in endpoint
							usbDevices_mount[USBDevicesMountedNum].inEndpoint = device.getInterface(0).getEndpoint(0); // read from out endpoint
							
							if(usbDevices_mount[USBDevicesMountedNum].connection == null)
							{
								if(true == fDebug)
									Log.i("readerlog","openDevice failed");
								break;
							}
							
							if(-1 == patchUSBDevice(usbDevices_mount[USBDevicesMountedNum]))
							{//Not in the current linked array, it's a new node
								RelHandle = fillUSBDevice(usbDevices_mount[USBDevicesMountedNum]);
								if(true == fDebug)
									Log.i("readerlog","Insert usb node,valid nodes=" + (USBDevicesMountedNum+1));
								break;
							}
							
							USBDevicesMountedNum++;
							if(true == fDebug)
								Log.i("readerlog","match usb ok,valid nodes="+ USBDevicesMountedNum);
						}
						else
						{
							if(true == fDebug)
								Log.i("readerlog",">>>>>>>>>>>>>>> reader number achieve max! <<<<<<<<<<<<");
							break;
						}
					}
					else if(true == fDebug)
						Log.i("readerlog",">>>>>>>>>>>>>>> reader interface is 0 <<<<<<<<<<<<");
				}
			}

		} catch (Exception e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			return -1;
		}
		
		
		if((RelHandle != -1) && (USBDevicesLinkedNum < MAX_USB_DEV_SUPPORT))
			USBDevicesLinkedNum++;
		
		return RelHandle;//1;
	}

	
	public int usb_onceSend(int hdev, char[] bufData, int slen) {
		int i;
		int transferedLen;
		
		//if(connection1 == null || usbInterface1== null || outEndpoint1 == null)
		if(-1 == ResetDeviceOperating(hdev))
			return -1;
		
		if (connection != null) {
			
			try
			{
				if (connection.claimInterface(usbInterface, true)) {
					byte[] byte2 = new byte[slen +1];
	
					for (i = 0; i < slen; i++)
						byte2[i] = (byte) bufData[i];
	
					transferedLen = connection.bulkTransfer(outEndpoint, byte2, slen, 10000);
					if(transferedLen < 0)
						return -1;
					if(true == fDebug)
					{
						for (Byte byte1 : byte2) {
							Log.d("readerlog", "send: " + Integer.toHexString(byte1 & 0xff));
						}
					}

	
				} else
				{
					if(true == fDebug)
					{
						Log.d("readerlog",
								"usb_onceSend err, connection.closed!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");
					}
				}
			}
			catch(Exception e)
			{
				e.printStackTrace();
				return -1;
			}
		}
		else
		{
			if(true == fDebug)
			{
				Log.e("readerlog",
						"usb_onceSend err, connection is nullxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
			}
		}


		return 0;
	}

	
	public int usb_onceReceive(int hdev, char[] bufData, int lenToRead) {

		byte[] bt = new byte[lenToRead+ 1];
		int i;
		
		if(-1 == ResetDeviceOperating(hdev))
			return -1;

		if (connection != null) {
			
			try
			{
				if (connection.claimInterface(usbInterface, true)) {
					int ret = connection.bulkTransfer(inEndpoint, bt, lenToRead,
							10000);//3000);
	
					if (ret != -1) {
						for (i = 0; i < ret; i++)
							bufData[i] = (char) (bt[i] & 0xff);
	
						if(true == fDebug)
						{
							for (Byte byte1 : bt) {
								Log.d("readerlog", "rev:" + Integer.toHexString(byte1 & 0xff));
							}
						}

					}
				} else {
					if(true == fDebug)
					{
						Log.d("readerlog",
								"usb_onceReceive err, connection.closed!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");
					}

					return -1;
				}
			}
			catch(Exception e)
			{
				e.printStackTrace();
				return -1;
			}
		}
		else
		{
			if(true == fDebug)
			{
				Log.e("readerlog",
						"usb_onceReceive err, connection is nullxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
			}
		}

		return 0;
	}
	
	public void usbClose(int handle)
	{
		int iHandle;
		
		if(handle > MAX_USB_DEV_SUPPORT)
			return;
		
		if(handle < 1)
			return;
		
		iHandle = handle -1;
		
		//if(usbDevices_linked[iHandle].usbHandle != -1)
		if(usbDevices_linked[iHandle].usbDevPath.equals("") == false)
		{
			if (usbDevices_linked[iHandle].connection != null) {
				usbDevices_linked[iHandle].connection.close();
				
				usbDevices_linked[iHandle].usbDevice = null;
				usbDevices_linked[iHandle].usbInterface = null;
				usbDevices_linked[iHandle].connection = null;
				usbDevices_linked[iHandle].outEndpoint = null;
				usbDevices_linked[iHandle].inEndpoint = null;
				usbDevices_linked[iHandle].usbHandle = -1;
				usbDevices_linked[iHandle].usbDevPath= "";
				USBDevicesLinkedNum--;
				
				if(true == fDebug)
					Log.i("readerlog", "device closed: "+handle);
			}
			else
			{
				if(true == fDebug)
					Log.i("readerlog", "Close a offline handle!!!");
			}
			//if(hostAct != null )
			//	hostAct.unregisterReceiver(mUsbReceiver);
		}
		else
		{
			if(true == fDebug)
				Log.i("readerlog", "Close a invalid handle!!!");
		}
	}
	
	public class USBDeviceInfo {
		public int  usbHandle;
		public String usbDevPath;
		public UsbDevice usbDevice;
		public UsbInterface usbInterface;
		public UsbDeviceConnection connection;
		public UsbEndpoint inEndpoint;
		public UsbEndpoint outEndpoint;
		public OutputStream m_OutputStream;
		public InputStream m_InputStream;
		public SerialPort m_serial;
		
		public USBDeviceInfo()
		{
			usbHandle = -1;
			usbDevPath = "";
		}
	}

	private final BroadcastReceiver mUsbReceiver = new BroadcastReceiver() {

		public void onReceive(Context context, Intent intent) {
			String action = intent.getAction();
			//Log.e("action", action);

			if (ACTION_USB_PERMISSION.equals(action)) {
				synchronized (this) {
					usbDevice = (UsbDevice) intent
							.getParcelableExtra(UsbManager.EXTRA_DEVICE);
					if (intent.getBooleanExtra(
							UsbManager.EXTRA_PERMISSION_GRANTED, false)) {

						if (usbDevice != null) {
							// do something
						}
					} else {
						//Log.d("denied", "permission denied for device "
						//		+ usbDevice);
					}
				}
			}
		}
	};
	

}
