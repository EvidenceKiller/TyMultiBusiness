<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_black">

    <Button
        android:id="@+id/bnt_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_16"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginEnd="@dimen/qb_px_16"
        android:layout_marginBottom="@dimen/qb_px_16"
        android:text="设置"
        android:textColor="@color/color_black"
        android:textSize="@dimen/text_size_16"/>

    <FrameLayout
        android:id="@+id/layout"
        android:layout_width="1280px"
        android:layout_height="720px">

        <SurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.adl.base.overlay.SportOverlayRopeSkip
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bnt_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_12" />

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂停"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_12" />

        <Button
            android:id="@+id/bnt_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="change"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_12" />
        <Button
            android:id="@+id/bnt_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_12" />

        <Button
            android:id="@+id/bnt_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一帧"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_12" />


    </LinearLayout>

</RelativeLayout>
