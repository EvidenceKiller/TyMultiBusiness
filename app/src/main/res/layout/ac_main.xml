<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人开合"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人下蹲"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人仰卧起坐"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人俯卧撑"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人体前屈"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人仰卧起坐"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人俯卧撑"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人体前屈"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_10_region_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="十人运动框设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人开合"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</RelativeLayout>
