<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人开合"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人下蹲"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/bnt_5_region_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5人框体设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="双人运动">

                <Button
                    android:id="@+id/btn_skip_gb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人国标跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_double_open_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人开合"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_skip_eight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="八字跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="双人运动">
                <Button
                    android:id="@+id/btn_six_ywqz_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6人仰卧起坐框体设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_six_ywqz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6人仰卧起坐"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/bnt_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人仰卧起坐"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人俯卧撑"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_three_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3人运动设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/bnt_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="坐位体前屈设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/bnt_zw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="坐位体前屈"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_forward_6_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6人坐位体前屈设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_forward_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6人坐位体前屈"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bnt_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_open_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人开合跳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_squat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人下蹲"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_side_to_side"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人左右跳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_high_knees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人高抬腿"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_10_region_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="十人运动框设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ipc_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IPC设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_face"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="十人人脸识别"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ten_sit_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10人仰卧起坐"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_ten_sit_up_region_setup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="十人仰卧起坐设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_thirty_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30人跳绳"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_et_ten_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30人跳绳客户端"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_left_screen_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左副屏IP"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_right_screen_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="右副屏IP"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_thirty_sport_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="三屏运动框设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_face_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="人脸识别测试"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_face_test2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="人脸识别测试无骨骼"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_double_face"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双人人脸识别测试"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_pic_identify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图片人脸识别"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_processor_identify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="人脸识别processor"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_nfc_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NFC读卡测试"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_body_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="框体测试"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_frame_animation_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="多序列帧动画"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btn_gesture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手势识别"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

            <!--       BMI     -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_bmi_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMI设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_bmi_sport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMI运动"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_lung_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="肺活量设置"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_lung_sport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="肺活量运动"
                    android:textColor="@color/color_black"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tv_org_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
